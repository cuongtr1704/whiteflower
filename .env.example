# Bản mẫu. Chép thành .env rồi điền:  cp .env.example .env
# File .env thật đã bị .gitignore chặn, không lên GitHub.
#
# Định dạng: TEN=giá trị. KHÔNG bọc dấu nháy - máy chủ lấy nguyên phần sau
# dấu bằng nên có nháy là nó tính cả dấu nháy vào giá trị.

# ---- Bắt buộc ----
# Khoá vào /admin và để tải bảng tính khách mời. Sinh khoá mới:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Bỏ trống thì mỗi lần khởi động máy chủ tự sinh khoá khác rồi in ra terminal -
# chạy thử thì tiện, nhưng đưa lên mạng là phải đặt cố định.
ADMIN_KEY=

# Tên chủ thiệp, hiện ở tiêu đề bảng khách và vài câu báo lỗi.
TEN_CHU_THIEP=

# Cổng chạy ở máy. Render tự đặt, khỏi khai trên đó.
PORT=

# ---- Khi đã đưa lên mạng ----
# Đặt 1 khi chạy sau Render/Railway/ngrok để chặn spam tính theo IP khách thật
# chứ không phải IP proxy. Chạy ở máy thì để 0.
TRUST_PROXY=

# ---- Chỗ lưu danh sách khách: chọn MỘT trong hai ----
# (tuỳ chọn khi chạy ở máy, bắt buộc khi lên mạng)
# Không chọn cái nào thì dữ liệu chỉ nằm ở data/rsvps.json, mà đĩa của Render bị
# xoá mỗi lần máy chủ ngủ dậy - danh sách khách sẽ mất.
#
# Cách A: lưu vào một repo GitHub RIÊNG TƯ. Gọn nhất, không cần dịch vụ mới.
# Token loại fine-grained, chỉ cấp quyền Contents (Read and write) cho đúng repo
# đó, không cấp thêm gì.
# GITHUB_TOKEN=
# DATA_REPO=tai-khoan-cua-ban/ten-repo-data
#
# Cách B: Postgres miễn phí ở Neon (https://neon.com).
# Có DATABASE_URL thì máy chủ ưu tiên database và bỏ qua GitHub.
# Đừng dùng Supabase: gói free tạm dừng project sau một tuần không ai đụng tới,
# mà thiệp mời thì nằm im nhiều ngày rồi mới có người vào.
# DATABASE_URL=

# ---- Báo tin qua Zalo (tuỳ chọn) ----
# Để trống là tắt hẳn. Ai dùng cách tải bảng tính thì không cần.
# Lấy chat id bằng:  node zalo.js
ZALO_BOT_TOKEN=
ZALO_CHAT_ID=
